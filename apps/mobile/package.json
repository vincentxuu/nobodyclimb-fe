{
  "name": "@nobodyclimb/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@nobodyclimb/api-client": "workspace:^",
    "@nobodyclimb/constants": "workspace:^",
    "@nobodyclimb/hooks": "workspace:^",
    "@nobodyclimb/schemas": "workspace:^",
    "@nobodyclimb/types": "workspace:^",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tamagui/config": "2.0.0-rc.0",
    "@tamagui/core": "2.0.0-rc.0",
    "@tamagui/font-inter": "2.0.0-rc.0",
    "@tamagui/shorthands": "2.0.0-rc.0",
    "@tanstack/react-query": "^5.85.0",
    "axios": "^1.11.0",
    "expo": "~54.0.33",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.6",
    "expo-dev-client": "~6.0.20",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~0.29.21",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.511.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-webview": "13.15.0",
    "tamagui": "2.0.0-rc.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@tamagui/babel-plugin": "2.0.0-rc.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.9",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lucide-react-native|@nobodyclimb/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@nobodyclimb/constants$": "<rootDir>/../../packages/constants/src/index.ts",
      "^@nobodyclimb/(.*)$": "<rootDir>/../../packages/$1/src/index.ts",
      "^tamagui$": "<rootDir>/src/__mocks__/tamagui.ts",
      "^@tamagui/core$": "<rootDir>/src/__mocks__/tamagui.ts",
      "^@tamagui/(.*)$": "<rootDir>/src/__mocks__/tamagui.ts",
      "^react-native-reanimated$": "<rootDir>/src/__mocks__/react-native-reanimated.ts",
      "^react-native-svg$": "<rootDir>/src/__mocks__/react-native-svg.js",
      "^@gorhom/bottom-sheet$": "<rootDir>/src/__mocks__/gorhom-bottom-sheet.ts"
    },
    "setupFilesAfterEnv": []
  }
}
